# Copy to .env.local and fill in. All data is stored in Notion, so Notion
# (OAuth or NOTION_TOKEN) is required. Without an Ashby key the form uses
# sample candidates.

# Ashby API key (Admin > Integrations > API keys; candidates + jobs read)
ASHBY_API_KEY=

# Notion OAuth connection (from the Notion developer portal). After saving,
# restart the app and click "Connect Notion" on the Offers page.
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=http://localhost:3000/api/notion/callback

# Alternative to OAuth: an internal integration secret
NOTION_TOKEN=

NOTION_OFFERS_DATABASE_ID=a577a4389bbe4bc3bfaea974285e0912
NOTION_TEMPLATES_DATABASE_ID=03d488fa16aa4c34b506b32f72ad8acd
NOTION_CANDIDATE_DETAILS_DATABASE_ID=a2b484ec4bb5451f8a2d0efe90926706
